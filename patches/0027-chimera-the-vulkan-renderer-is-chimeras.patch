+// name (chimera_vk_lookup); each one hands its call to the frontend.
+extern "C" void* chimera_vk_lookup(const char* name);
+static bool s_chimera_vulkan_loaded = false;
+
+bool Vulkan::IsVulkanLibraryLoaded()
+{
+	return s_chimera_vulkan_loaded;
